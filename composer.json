{
    "name": "nswdpc/silverstripe-pwnage-hinter",
    "description": "Verify hashed passwords against HIBP",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "pwnage",
        "pwnedpasswords",
        "password",
        "haveibeenpwned",
        "hibp",
        "breach",
        "security"
    ],
    "require": {
        "mflor/pwned" : "^4",
        "symbiote/silverstripe-queuedjobs" : "^5",
        "symbiote/silverstripe-multivaluefield" : "^6",
        "silverstripe/framework" : "^5"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^2",
        "phpunit/phpunit": "^9.5",
        "cambis/silverstan": "^2",
        "nswdpc/ci-files": "dev-v-4",
        "phpstan/phpstan": "^2",
        "rector/rector": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "authors": [
        {
            "name": "James Ellis",
            "role": "Developer"
        }
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
